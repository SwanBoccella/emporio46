/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https:; connect-src 'self' blob: data: https://api.github.com https://gist.githubusercontent.com https://api.groq.com https://generativelanguage.googleapis.com https://api.emailjs.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://www.google.com https://maps.google.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Le Function private non si memorizzano mai (site-data e asset gestiscono la cache da sole, vedi netlify/functions)
/.netlify/functions/admin-api
  Cache-Control: no-store
/.netlify/functions/groq-proxy
  Cache-Control: no-store
/.netlify/functions/gemini-proxy
  Cache-Control: no-store

# Risparmio crediti: file statici in cache a lungo nel browser (meno richieste e meno banda).
# Per sostituire un file con lo stesso nome, cambiargli nome (es. hero-video-2.mp4).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/bg/*
  Cache-Control: public, max-age=2592000
/catalog/*
  Cache-Control: public, max-age=2592000
/models/*
  Cache-Control: public, max-age=2592000
/logo.png
  Cache-Control: public, max-age=2592000
/favicon.png
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# SEO: sitemap e robots si rileggono ogni giorno; l'immagine social resta in cache a lungo
/sitemap.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=2592000
/og-image.jpg
  Cache-Control: public, max-age=2592000
