# Copia questo file in .env.local per lo sviluppo. In produzione le variabili si impostano su Netlify.
# .env.local è nel .gitignore: non committarlo mai.

# ── Pubbliche (finiscono nel sito: solo valori non segreti) ──────────────────
VITE_GIST_ID=5ccce43aaac009268acf164b4808fded    # ID del Gist letto dai visitatori

# EmailJS — max 2 template (piano gratuito). Opzionali: in alternativa dal pannello admin.
VITE_EMAILJS_SERVICE=service_m7lkgmr
VITE_EMAILJS_PUBLIC_KEY=9uhOy7c1M5GntXjls
VITE_EMAILJS_TEMPLATE=template_82qn6hr    # notifica al negozio (tutte e 3 le schede)
VITE_EMAILJS_TEMPLATE_CLIENT=template_uzprmdo    # (opzionale) conferma al cliente

# ── SEGRETE, solo server (SENZA prefisso VITE_) — impostale solo su Netlify ──
# ADMIN_PASSWORD=                # password pannello admin (16+ caratteri)
# GIST_TOKEN=                    # token GitHub classic con SOLO lo scope "gist"
# ADMIN_PASSWORD_FORCE_ENV=      # opzionale: 1 = ignora la password cambiata dal pannello e usa ADMIN_PASSWORD
# GIST_ID=                       # opzionale: se assente la Function usa VITE_GIST_ID

# ── Groq (AI) ────────────────────────────────────────────────────────────────
# GROQ_API_KEY=                  # SEGRETA, solo Netlify (senza VITE_): usata dalla Function groq-proxy
# In locale (npm run dev) metti la chiave in .env.local come VITE_GROQ_DEV_KEY=gsk_… (mai su Netlify!)

# ── Archivio contenuti (v57_9) ─────────────────────────────────────────────
# Priorità: Netlify Database (Postgres) → Netlify Blobs → Gist.
# - Netlify Database: si attiva da solo al deploy grazie al pacchetto @netlify/database (migrazione in netlify/database/migrations).
# - Netlify Blobs: sempre attivo su Netlify, nessuna variabile.
# - Gist (GIST_ID + GIST_TOKEN): ora opzionale, resta come copia di sicurezza e fonte per migrare i dati esistenti.
