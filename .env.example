# Copia questo file in .env.local per lo sviluppo (npm run dev). .env.local è nel .gitignore: non committarlo mai.

# ── Pubbliche (VITE_*: finiscono nel sito, solo valori non segreti) ──────────
# In produzione vanno impostate come VARIABILI DI BUILD su Cloudflare:
#   Workers & Pages → emporio46 → Settings → Build → Variables and secrets
VITE_GIST_ID=5ccce43aaac009268acf164b4808fded    # (opzionale) ID del Gist letto come fallback
VITE_EMAILJS_SERVICE=service_m7lkgmr
VITE_EMAILJS_PUBLIC_KEY=9uhOy7c1M5GntXjls
VITE_EMAILJS_TEMPLATE=template_82qn6hr           # notifica al negozio
VITE_EMAILJS_TEMPLATE_CLIENT=template_uzprmdo    # (opzionale) conferma al cliente

# ── SEGRETI, solo server (SENZA prefisso VITE_) ──────────────────────────────
# In produzione: Workers & Pages → emporio46 → Settings → Variables and secrets, tipo "Secret"
# (oppure da terminale: npx wrangler secret put NOME). In locale con `npm run preview:cf`: file .dev.vars
# ADMIN_PASSWORD=            # password iniziale del pannello admin (16+ caratteri)
# GROQ_API_KEY=              # chiave Groq (gsk_…): usata dal Worker /api/groq-proxy
# SESSION_SECRET=            # (consigliato) stringa casuale lunga per firmare le sessioni admin
# ADMIN_PASSWORD_FORCE_ENV=  # opzionale: 1 = ignora la password cambiata dal pannello e usa ADMIN_PASSWORD
# GIST_ID=                   # opzionali: copia di sicurezza dei contenuti su GitHub Gist
# GIST_TOKEN=                #   (token GitHub classic con SOLO lo scope "gist")

# In locale (npm run dev) la chiave Groq va in .env.local come VITE_GROQ_DEV_KEY=gsk_… (mai in produzione!)

# ── Archivio contenuti ───────────────────────────────────────────────────────
# Cloudflare D1 (binding DB)  → contenuti del sito (impostazioni, catalogo, recensioni, SEO) e password admin
# Cloudflare R2 (binding FILES) → immagini, video di sfondo e modello 3D caricati dal pannello
# Entrambi sono dichiarati in wrangler.jsonc e creati automaticamente al primo deploy.
